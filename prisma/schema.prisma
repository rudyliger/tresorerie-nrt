generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Comptes bancaires ────────────────────────────────────────────────────────

model BankAccount {
  id             String    @id @default(cuid())
  name           String    @unique
  code           String    @unique
  currentBalance Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]
}

// ─── Entités (pour les recettes) ─────────────────────────────────────────────

model Entity {
  id               String               @id @default(cuid())
  name             String               @unique
  code             String               @unique
  order            Int                  @default(99)
  revenues         Revenue[]
  weeklyObjectives WeeklyCAObjective[]
  dailyObjectives  DailyCAObjective[]
}

// ─── Catégories de dépenses ───────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  order    Int       @default(0)
  payments Payment[]
}

// ─── Paiements / Dépenses ─────────────────────────────────────────────────────

model Payment {
  id                  String      @id @default(cuid())
  label               String
  amount              Float
  dueDate             DateTime
  method              PaymentMethod
  isPaid              Boolean     @default(false)
  paidAt              DateTime?
  notes               String?

  // Récurrence
  isRecurring         Boolean     @default(false)
  recurringDayOfMonth Int?
  parentId            String?
  parent              Payment?    @relation("Recurrences", fields: [parentId], references: [id])
  children            Payment[]   @relation("Recurrences")

  categoryId          String
  category            Category    @relation(fields: [categoryId], references: [id])

  bankAccountId       String
  bankAccount         BankAccount @relation(fields: [bankAccountId], references: [id])

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

enum PaymentMethod {
  VIREMENT
  PRELEVEMENT
  CHEQUE
  CB
  EFFET
}

// ─── Recettes ─────────────────────────────────────────────────────────────────

model Revenue {
  id        String   @id @default(cuid())
  amount    Float
  date      DateTime
  notes     String?

  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Objectifs CA hebdomadaires ───────────────────────────────────────────────

model WeeklyCAObjective {
  id           String   @id @default(cuid())
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id])
  weekStart    DateTime // Lundi de la semaine, à midi UTC
  targetAmount Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([entityId, weekStart])
  @@index([weekStart])
}

// ─── Prêts bancaires ──────────────────────────────────────────────────────────

model Loan {
  id              String            @id @default(cuid())
  loanNumber      String?
  name            String
  bankName        String
  iban            String?
  initialAmount   Float
  remainingAmount Float
  interestRate    Float?
  durationMonths  Int?
  monthlyPayment  Float
  nextDueDate     DateTime
  endDate         DateTime
  notes           String?
  loanType        String            @default("PRET")
  residualValue   Float?
  schedule        LoanInstallment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model LoanInstallment {
  id               String   @id @default(cuid())
  loanId           String
  loan             Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  dueDate          DateTime
  totalAmount      Float
  principal        Float
  interest         Float
  remainingBalance  Float
  installmentNumber Int?
  createdAt         DateTime @default(now())

  @@index([loanId, dueDate])
}

// ─── Chéquier ─────────────────────────────────────────────────────────────────

model Cheque {
  id               String        @id @default(cuid())
  number           String
  recipient        String
  subject          String
  amount           Float
  issuedAt         DateTime
  expectedCashDate DateTime?
  actualCashDate   DateTime?
  status           ChequeStatus  @default(EN_ATTENTE)
  chequier         String?       // Identifiant du carnet de chèques source
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum ChequeStatus {
  EN_ATTENTE
  ENCAISSE
  ANNULE
}

// ─── Objectifs CA journaliers (magasins) ─────────────────────────────────────

model DailyCAObjective {
  id           String   @id @default(cuid())
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id])
  date         DateTime // Jour exact, à midi UTC
  targetAmount Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([entityId, date])
  @@index([date])
}

// ─── Historique des soldes bancaires ──────────────────────────────────────────

model BalanceSnapshot {
  id            String   @id @default(cuid())
  bankAccountId String
  balance       Float
  snapshotDate  DateTime
  createdAt     DateTime @default(now())

  @@unique([bankAccountId, snapshotDate])
  @@index([bankAccountId, snapshotDate])
}
